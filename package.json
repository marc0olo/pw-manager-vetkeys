{
  "name": "pw-manager-vetkeys",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke-test": "node scripts/smoke-test.mjs",
    "check-ii-metadata": "node scripts/check-ii-metadata.mjs",
    "test": "vitest run",
    "test:motoko": "mops test",
    "test:watch": "vitest",
    "check-poll-cost": "node scripts/check-poll-cost.mjs",
    "check-capabilities": "node scripts/check-capabilities.mjs",
    "check-vault-names": "node scripts/check-vault-names.mjs",
    "bindings": "icp build backend && icp-bindgen --did-file .mops/.build/backend.did --out-dir src/bindings --actor-disabled --force && cp .mops/.build/backend.most src/bindings/backend.most",
    "check-bindings": "node scripts/check-bindings.mjs",
    "check-history": "node scripts/check-history.mjs",
    "check-owned-vaults": "node scripts/check-owned-vaults.mjs"
  },
  "dependencies": {
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^5.4.0",
    "@icp-sdk/vetkeys": "^0.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "^0.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
