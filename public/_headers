/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://icp-api.io https://*.icp0.io https://*.icp.net; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# Fingerprinted build assets never change — cache them hard
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so a redeploy is picked up
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Internet Identity reads these cross-origin from the sign-in screen, so both
# need CORS. The metadata document has no file extension, so its media type must
# be set with the bare `Content-Type:` form.
/.well-known/ii-app-metadata
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/logo.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
